# Copy to .env and fill in. .env is gitignored; this repo is public.

# --- Google Cloud (decided platform) ---
GOOGLE_CLOUD_PROJECT=
GOOGLE_APPLICATION_CREDENTIALS=./gcp-key.json
OWP_GCS_BUCKET=
OWP_REGION=us-central1

# --- Script writer LLM (provider still OPEN - see docs Q2.6) ---
# Set OWP_LLM_PROVIDER to one of: gemini | anthropic
OWP_LLM_PROVIDER=gemini
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# --- Instagram Graph API (component 4; needs Business/Creator account, Q4.1) ---
IG_USER_ID=
IG_ACCESS_TOKEN=

# --- Popularity data (Q1.3 - license not yet confirmed) ---
SENSOR_TOWER_API_KEY=

# --- Notification (Q3.2/Q3.3: email + authenticated review page) ---
OWP_NOTIFY_EMAIL=
OWP_REVIEW_BASE_URL=
